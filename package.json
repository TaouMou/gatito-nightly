{
  "name": "gatito-nightly",
  "displayName": "Feles",
  "description": "Soft, JetBrains-inspired dark and light themes in four cat coats: Cinnamon, Russian Blue, Siamese and Marmalade.",
  "version": "2.0.0",
  "publisher": "TaouMou",
  "license": "MIT",
  "icon": "images/logo.png",
  "homepage": "https://github.com/TaouMou/gatito-nightly/blob/main/README.md",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TaouMou/gatito-nightly"
  },
  "keywords": [
    "Theme",
    "Dark theme",
    "Light theme",
    "Feles",
    "Cat",
    "Cinnamon",
    "Russian Blue",
    "Siamese",
    "Marmalade",
    "JetBrains",
    "Islands",
    "Nord",
    "Gatito",
    "Gatito Nightly",
    "Taoumou"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Feles Cinnamon Dark",
        "id": "Gatito Nightly Red",
        "uiTheme": "vs-dark",
        "path": "./themes/feles-cinnamon-dark-color-theme.json"
      },
      {
        "label": "Feles Cinnamon Light",
        "id": "Gatito Daylight Red",
        "uiTheme": "vs",
        "path": "./themes/feles-cinnamon-light-color-theme.json"
      },
      {
        "label": "Feles Russian Blue Dark",
        "id": "Gatito Nightly Blue",
        "uiTheme": "vs-dark",
        "path": "./themes/feles-russian-blue-dark-color-theme.json"
      },
      {
        "label": "Feles Russian Blue Light",
        "id": "Gatito Daylight Blue",
        "uiTheme": "vs",
        "path": "./themes/feles-russian-blue-light-color-theme.json"
      },
      {
        "label": "Feles Siamese Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/feles-siamese-dark-color-theme.json"
      },
      {
        "label": "Feles Siamese Light",
        "uiTheme": "vs",
        "path": "./themes/feles-siamese-light-color-theme.json"
      },
      {
        "label": "Feles Marmalade Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/feles-marmalade-dark-color-theme.json"
      },
      {
        "label": "Feles Marmalade Light",
        "uiTheme": "vs",
        "path": "./themes/feles-marmalade-light-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-variants.js",
    "screenshots": "node scripts/screenshots.js",
    "package": "vsce package",
    "start": "npm run build && npm run package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "playwright-core": "^1.64.1",
    "vsce": "^1.96.1"
  }
}
